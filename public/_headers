# Portable caching rules — the _headers equivalent of the [[headers]] blocks in
# netlify.toml, so the same cache behaviour follows the site to Cloudflare Pages
# or any other host that reads this format.

# Images and videos: cache for 30 days so repeat visits and page switches are
# instant, but still refresh within a month if a file is replaced in place.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Vite fingerprints every bundle (index-<hash>.js, JackSite-<hash>.js), so a new
# build always has a new filename — these are safe to cache forever.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
/assets/JackSite-*
  Cache-Control: public, max-age=31536000, immutable
/assets/VexSite-*
  Cache-Control: public, max-age=31536000, immutable
/assets/ToonhubSite-*
  Cache-Control: public, max-age=31536000, immutable
/assets/OddySite-*
  Cache-Control: public, max-age=31536000, immutable

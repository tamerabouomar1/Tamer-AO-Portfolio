# Caching rules, in the format Cloudflare Workers reads natively. This mirrors
# the [[headers]] blocks in netlify.toml so the same behaviour applies whichever
# host is serving the site.
#
# Deliberately ONE broad rule rather than a rule per bundle: everything Vite
# emits into /assets is content-hashed (index-<hash>.js, JackSite-<hash>.css),
# so a changed file always arrives under a new name and can never be served
# stale. The unhashed files in here are images, which a month of caching suits
# anyway — and stale-while-revalidate refreshes them in the background if one
# is replaced in place.
#
# NOTE: there is deliberately no _redirects file next to this one. SPA routing
# is handled by "not_found_handling": "single-page-application" in
# wrangler.jsonc. Cloudflare rejects the usual `/*  /index.html  200` rule
# outright — it strips `.html` and `/index` itself, so it reads that rule as an
# infinite redirect loop and fails the whole deploy with error 100324.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# The client-site copies under /demo are snapshots of sites that live on their
# own domains — majd.abouomar.workers.dev is the explicit case, and every other
# one either is live somewhere else or will be. Indexed here, a snapshot is a
# second copy of a client's site on someone else's domain: it competes with the
# real one for the client's own name, and it can never be as current.
#
# noindex keeps them out of search; `follow` keeps the links inside them
# working as crawl paths. They stay fully reachable — the store cards frame
# them live, and the card now carries a real link to each — so nothing a
# visitor can do changes.
#
# Set as a header rather than a <meta> tag in each file because these folders
# are re-pulled wholesale when a client's site changes: a meta tag would be
# overwritten and silently lost, a rule here cannot be.
/demo/*
  X-Robots-Tag: noindex, follow

# NOTE: the no-store rule for HTML is NOT here. A path rule like `/*.html`
# never matches /websites, which is a URL without an extension served from
# websites/index.html, so page routes kept their cacheable header while only
# the bare `/` got covered. It is set in worker/index.js instead, keyed on the
# response content-type, which cannot miss a route.

# Security headers, applied to every response.
#
# The one that does the work is script-src 'self': no inline script, no eval,
# no script from anywhere but this origin. If a bug ever let a visitor's text
# reach the page as markup, that rule is what stops it from being able to run.
# Vite emits every bundle as an external, content-hashed file, so nothing on
# the site needs an exception — and the JSON-LD block in index.html is a data
# block, not executable script, so CSP does not apply to it.
#
# img-src / media-src / frame-src are deliberately broad (https:). The template
# previews pull screenshots, video and live embeds from hosts that change as
# templates are added, and pinning them would break the work page every time
# one moved. Loosening those costs little while script-src stays strict: an
# image from the wrong host is an image, not code.
/*
  # challenges.cloudflare.com is Turnstile, the spam check on the forms. It
  # needs script-src (its widget script) and frame-src (it runs the actual
  # challenge inside an iframe). Remove either and every form on the site
  # stops being submittable.
  #
  # The MyChatBot assistant was removed on 2026-08-21 and its CSP exceptions
  # came out with it: storage.googleapis.com is gone from script-src and
  # style-src, and wss://api.mychatbot.app from connect-src.
  #
  # static.cloudflareinsights.com is Cloudflare Web Analytics, added 2026-08-25
  # with the move to tamerabouomar.com. Cloudflare injects that beacon into
  # every proxied response by itself, so this is not a choice to load it — it
  # is a choice between allowing it and having the browser log a CSP violation
  # on every page load while collecting no analytics at all. It is a
  # single-purpose first-party host owned by the same company already serving
  # this site, which is a far narrower grant than the shared bucket the chat
  # widget needed. To remove it, turn Web Analytics off in the Cloudflare
  # dashboard FIRST, then delete it here.
  #
  # db.onlinewebfonts.com and cdnjs.cloudflare.com are in style-src as well as
  # font-src because both serve a STYLESHEET that then references the font
  # files: onlinewebfonts is where several templates get their display faces
  # (Helvetica Neue Light, basis33, BubbledotICG…), cdnjs is Font Awesome's
  # icon CSS. font-src alone is not enough — the @font-face rules never load,
  # the request is blocked at the <link>, and the template silently falls back
  # to Arial. Neither is in script-src, and neither ever needs to be.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com https://db.onlinewebfonts.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://api.fontshare.com https://db.onlinewebfonts.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  # Only this site may frame this site. Stops the page being loaded invisibly
  # over someone else's, so a click they think lands on their page lands on
  # yours — while still allowing the store's own template previews, which are
  # same-origin iframes running the real /templates/:slug page.
  #
  # This was DENY, and DENY blocks same-origin framing too: every preview on
  # /websites went blank with "Framing violates frame-ancestors 'none'". The
  # clickjacking this defends against is by definition cross-origin, so
  # SAMEORIGIN gives up nothing. Keep this in step with frame-ancestors above.
  X-Frame-Options: SAMEORIGIN
  # Browsers must honour the declared Content-Type instead of sniffing it. An
  # uploaded or user-named file can otherwise be guessed into being script.
  X-Content-Type-Options: nosniff
  # Send the full URL to same-origin requests, only the origin to other sites.
  # Anything with a token in the query string then stops leaking that token in
  # the Referer header the moment a visitor clicks an outbound link.
  Referrer-Policy: strict-origin-when-cross-origin
  # None of this is a site that needs a camera, a microphone or a location.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # HTTPS only, for two years, on this host and its subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off
